# Staging configuration. Build/run with:
#   docker compose --env-file .env.staging up --build -d
#
# These values are consumed at BUILD time (NEXT_PUBLIC_* is inlined into the
# client bundle; API_PROXY_TARGET is frozen into the rewrite manifest), so a
# domain change always requires a rebuild.

PORT=3000

# Staging backend the Next.js server proxies /api/v1/* to. SERVER-ONLY — the
# browser only ever calls this app's own origin; next.config.ts rewrites those
# to <API_PROXY_TARGET>/api/v1/*, so the backend origin is never shipped.
API_PROXY_TARGET=https://api.dev.osustocks.com

# Staging public web origin — base for absolute OpenGraph/Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://dev.osustocks.com
